<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:IsoViewport.Controls.Controls"
             xmlns:vm="using:IsoViewport.Harness.ViewModels"
             x:Class="IsoViewport.Harness.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Background="#20242B" Padding="10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding LoadSmallMapCommand}" Content="Small" />
          <Button Command="{Binding LoadMediumMapCommand}" Content="Medium" />
          <Button Command="{Binding LoadFlatMapCommand}" Content="Flat" />
          <Button Command="{Binding ResetViewCommand}" Content="Reset" />
          <Button Command="{Binding RotateLeftCommand}" Content="Rotate Left" />
          <Button Command="{Binding RotateRightCommand}" Content="Rotate Right" />
          <Button Command="{Binding AddSampleHighlightsCommand}" Content="Sample Highlights" />
          <Button Command="{Binding ClearHighlightsCommand}" Content="Clear Highlights" />
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="18,0,0,0" Orientation="Horizontal" Spacing="8">
          <ComboBox Width="160"
                    ItemsSource="{Binding RenderModes}"
                    SelectedItem="{Binding RenderMode, Mode=TwoWay}" />
          <ToggleSwitch IsChecked="{Binding IsTopDownView, Mode=TwoWay}"
                        OnContent="Top-Down"
                        OffContent="3D"
                        VerticalAlignment="Center" />
          <ToggleSwitch IsChecked="{Binding AnimationsEnabled, Mode=TwoWay}"
                        OnContent="Anim On"
                        OffContent="Anim Off"
                        VerticalAlignment="Center" />
          <ToggleSwitch IsChecked="{Binding IsMiniMapVisible, Mode=TwoWay}"
                        OnContent="Mini On"
                        OffContent="Mini Off"
                        VerticalAlignment="Center" />
          <ComboBox Width="150"
                    ItemsSource="{Binding MiniMapLocations}"
                    SelectedItem="{Binding MiniMapLocation, Mode=TwoWay}" />
          <ToggleSwitch IsChecked="{Binding IsHoverHighlightEnabled, Mode=TwoWay}"
                        OnContent="Hover Glow"
                        OffContent="Hover Off"
                        VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14">
          <TextBlock Foreground="#D7DEE8" VerticalAlignment="Center" Text="{Binding Fps, StringFormat='FPS {0:0}'}" />
          <TextBlock Foreground="#D7DEE8" VerticalAlignment="Center" Text="{Binding MapDimensions}" />
          <TextBlock Foreground="#D7DEE8" VerticalAlignment="Center" Text="{Binding ScenarioName}" />
          <TextBlock Foreground="#D7DEE8" VerticalAlignment="Center" Text="{Binding VisibleChunks, StringFormat='Chunks {0}'}" />
          <TextBlock Foreground="#D7DEE8" VerticalAlignment="Center" Text="{Binding RenderedTiles, StringFormat='Tiles {0}'}" />
          <TextBlock Foreground="#D7DEE8" VerticalAlignment="Center" Text="{Binding VertexCount, StringFormat='Verts {0}'}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="ViewportHost" Grid.Row="1" ClipToBounds="True">
      <controls:IsoViewport
          PieceTypeDefinitions="{Binding PieceTypeDefinitions}"
          TileMap="{Binding TileMap}"
          TileHighlights="{Binding TileHighlights}"
          CameraZoom="{Binding CameraZoom, Mode=TwoWay}"
          CameraPanX="{Binding CameraPanX, Mode=TwoWay}"
          CameraPanY="{Binding CameraPanY, Mode=TwoWay}"
          CameraRotationDegrees="{Binding CameraRotationDegrees, Mode=TwoWay}"
          ViewProjectionMode="{Binding ViewProjectionMode, Mode=TwoWay}"
          RenderMode="{Binding RenderMode, Mode=TwoWay}"
          AnimationsEnabled="{Binding AnimationsEnabled, Mode=TwoWay}"
          IsMiniMapVisible="{Binding IsMiniMapVisible, Mode=TwoWay}"
          MiniMapLocation="{Binding MiniMapLocation, Mode=TwoWay}"
          HoveredTile="{Binding HoveredTile, Mode=OneWayToSource}"
          TileHoverCommand="{Binding HandleTileHoverCommand}"
          TileClickCommand="{Binding HandleTileClickCommand}"
          VisibleTiles="{Binding VisibleTiles, Mode=OneWayToSource}"
          VertexCount="{Binding VertexCount, Mode=OneWayToSource}"
          VisibleChunks="{Binding VisibleChunks, Mode=OneWayToSource}"
          RenderedTiles="{Binding RenderedTiles, Mode=OneWayToSource}"
          Fps="{Binding Fps, Mode=OneWayToSource}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch" />

      <Border HorizontalAlignment="Left"
              VerticalAlignment="Bottom"
              Margin="14"
              Padding="10,8"
              Background="#B011151B">
        <StackPanel Spacing="3">
          <TextBlock Foreground="#E7EDF5" Text="{Binding HoveredTileText}" />
          <TextBlock Foreground="#E7EDF5" Text="{Binding LastClickText}" />
          <TextBlock Foreground="#AFC0D3" Text="WASD/arrows pan, scroll zooms, Q/E rotates, R resets, Space toggles animation." />
          <TextBlock Foreground="#AFC0D3" Text="Left click toggles a host-owned selection highlight. Hover glow is also host-owned." />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
